# 이 파일을 .env.local 로 복사해서 쓰세요.

# Spring Boot 백엔드 주소.
# 로컬 개발: http://localhost:8080
# AWS 배포본 테스트: http://13.236.175.235:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Google Maps Platform API 키 (지도 렌더링용, Maps JavaScript API) — 브라우저에 노출되는 키라
# Google Cloud Console에서 "API 제한사항"으로 이 API만 쓰게 걸어두고 HTTP 리퍼러 제한도 걸 것.
# 발급 방법: capstone_web_version/TODO_AND_MAPS_PLAN.md의 Part 2, Step 2~3 참고
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase Cloud Messaging (FCM 웹 푸시 알림용)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

